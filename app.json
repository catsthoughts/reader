{
  "expo": {
    "name": "Epub Reader",
    "slug": "epub-reader",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.epubreader.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.epubreader.app"
    },
    "plugins": [
      "expo-sqlite",
      "expo-document-picker",
      "expo-asset",
      "expo-web-browser"
    ]
  }
}
